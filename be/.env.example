# Copia questo file in be/.env (ignorato da git) e compila i valori.
# Su Render le stesse chiavi si impostano come variabili del servizio backend.

# Almeno 32 caratteri casuali, es. openssl rand -base64 48
JWT_SECRET=
# Password dell'amministratore creato al primo avvio (almeno 12 caratteri; email: ADMIN_EMAIL, default admin@salone.it)
ADMIN_PASSWORD=
# Indirizzo Gmail e "password per le app" a 16 caratteri (non la password dell'account)
MAIL_USERNAME=
MAIL_PASSWORD=
